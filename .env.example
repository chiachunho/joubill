# --- Telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Custom secret you pass to setWebhook; Telegram echoes it back via
# the X-Telegram-Bot-Api-Secret-Token header on every webhook hit.
TELEGRAM_WEBHOOK_SECRET=
# Short name from @BotFather /newapp (e.g. "splitbill"). Used to build the
# direct-link Mini App URL: https://t.me/<bot>/<TELEGRAM_MINI_APP_NAME>
TELEGRAM_MINI_APP_NAME=

# --- Database (Neon) ---
# Neon connection string. Use the "Pooled connection" + "?sslmode=require".
DATABASE_URL=

# --- Mini App ---
# Public URL of the deployed Mini App; used to build the web_app button.
NEXT_PUBLIC_MINI_APP_URL=https://your-domain.vercel.app/mini

# --- FX (optional) ---
# Defaults to exchangerate.host (free, no API key). Swap if you change providers.
FX_API_BASE=https://api.exchangerate.host
