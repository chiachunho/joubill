# --- Telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Custom secret you pass to setWebhook; Telegram echoes it back via
# the X-Telegram-Bot-Api-Secret-Token header on every webhook hit.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Short name from @BotFather /newapp (e.g. "joubill"). Used to build the
# direct-link Mini App URL: https://t.me/<bot>/<TELEGRAM_MINI_APP_NAME>
TELEGRAM_MINI_APP_NAME=
# chat_id of a private channel used as receipt-photo storage (a large negative
# number, e.g. -1001234567890). The bot must be an admin with "Post Messages".
TELEGRAM_STORAGE_CHAT_ID=

# --- Database (Neon) ---
# Neon connection string. Use the "Pooled connection" + "?sslmode=require".
DATABASE_URL=

# --- Mini App ---
# Public URL of the deployed Mini App; used to build the web_app button.
# Baked at build time — changing it requires a redeploy.
NEXT_PUBLIC_MINI_APP_URL=https://your-domain.vercel.app/mini

# --- Web login (Auth.js) ---
# Signs Auth.js sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=
# From @BotFather → Bot Settings → Web Login
AUTH_TELEGRAM_CLIENT_ID=
AUTH_TELEGRAM_CLIENT_SECRET=

# Optional extra web-login providers (each enabled only when its pair is set).
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# LINE Login channel (developers.line.biz). Callback: https://<domain>/api/auth/callback/line
# AUTH_LINE_ID=
# AUTH_LINE_SECRET=

# Optional: contact address shown on /help/privacy and /help/terms
# CONTACT_EMAIL=

# Optional: Web Push (enabled only when all three are set). Generate once with
# `npx web-push generate-vapid-keys`; a new pair invalidates every subscription.
# The public key is baked in at build time.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
