# --- Telegram ---
# 從 @BotFather 取得
TELEGRAM_BOT_TOKEN=
# 設 webhook 時自訂的密鑰（Telegram 會在 X-Telegram-Bot-Api-Secret-Token header 回傳）
TELEGRAM_WEBHOOK_SECRET=

# --- Database (Neon) ---
# Neon 控制台 Connection string，記得選 "Pooled connection" + "?sslmode=require"
DATABASE_URL=

# --- Mini App ---
# 部署後的公開 URL，用來組 web_app button
NEXT_PUBLIC_MINI_APP_URL=https://your-domain.vercel.app/mini

# --- FX (optional) ---
# exchangerate.host 免費；如改用其他 provider 自行替換
FX_API_BASE=https://api.exchangerate.host
